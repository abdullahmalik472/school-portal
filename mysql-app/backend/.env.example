PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Anyone registering as admin must type one of these codes (comma separated)
ADMIN_CODES=ADMIN-ALI-1001,ADMIN-SARA-2002

# Use 127.0.0.1 (not "localhost"): on newer Node, localhost can resolve to IPv6 and fail
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Keep the double quotes if the password contains a "#"
DB_PASSWORD="your-mysql-password"
DB_NAME=school

# ---- scheduled report (node-cron) ----
# Every 10 minutes, report = students/courses created in the last 10 minutes
REPORT_SCHEDULE="*/10 * * * *"
REPORT_WINDOW_MINUTES=10
# For a 1-minute report instead:  REPORT_SCHEDULE="* * * * *"  and  REPORT_WINDOW_MINUTES=1
ENABLE_NODE_CRON=true
# Protects GET /cron/report (send it as header x-cron-secret). Any long random string.
CRON_SECRET=change-me-too

# ---- MySQL -> Supabase one-way copy (leave both empty to keep it OFF) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SYNC_SCHEDULE="*/5 * * * *"
