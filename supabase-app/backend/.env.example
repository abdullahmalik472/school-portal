PORT=4001
JWT_SECRET=change-me-to-a-long-random-string
# Anyone registering as admin must type one of these codes (comma separated)
ADMIN_CODES=ADMIN-ALI-1001,ADMIN-SARA-2002

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the "service_role" key. Keep it ONLY in this backend, never in the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key
