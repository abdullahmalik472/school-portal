# Addresses of the two Express backends.
# Local: 4000 (MySQL) and 4001 (Supabase)  |  Vercel: your two Railway https URLs, no trailing slash
MYSQL_API_URL=http://localhost:4000
SUPABASE_API_URL=http://localhost:4001

# Only needed if you run `npm start` over plain http on another PC / LAN IP (cookies would be dropped otherwise)
# COOKIE_SECURE=false
